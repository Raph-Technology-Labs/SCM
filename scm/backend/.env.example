# Copy to .env and adjust. The +psycopg2 driver prefix is required by SQLAlchemy.
DATABASE_URL=postgresql+psycopg2://scm_user:scm_password@localhost:5432/scm

# Set to true to log every SQL statement during development.
SQL_ECHO=false

# Directory holding AI model weight files (bolt.pt, nut.pt, ...).
MODELS_DIR=./models

APP_NAME=MV Desktop APP
